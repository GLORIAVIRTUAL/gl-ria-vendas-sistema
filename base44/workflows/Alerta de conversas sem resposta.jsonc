{
  "name": "Alerta de conversas sem resposta",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_conversas_sem_resposta",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verificar_conversas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertaConversasSemResposta"
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar conversas sem resposta",
            "description": "Avisa o dono no WhatsApp"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Recife",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "A cada 15 minutos, verifica clientes que escreveram no WhatsApp e ainda n\u00e3o receberam resposta, e avisa o dono."
}