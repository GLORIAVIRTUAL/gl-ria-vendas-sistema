{
  "name": "Prospect",
  "type": "object",
  "properties": {
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "situacao_cadastral": {
      "type": "string",
      "description": "Situa\u00e7\u00e3o cadastral"
    },
    "segmento": {
      "type": "string",
      "description": "Segmento empresarial"
    },
    "ramo_atividade": {
      "type": "string",
      "description": "Ramo de atividade"
    },
    "cnae": {
      "type": "string",
      "description": "CNAE principal"
    },
    "porte": {
      "type": "string",
      "description": "Porte da empresa"
    },
    "faturamento": {
      "type": "number",
      "description": "Faturamento estimado"
    },
    "faixa_funcionarios": {
      "type": "string",
      "description": "Faixa de funcion\u00e1rios"
    },
    "capital_social": {
      "type": "number",
      "description": "Capital social"
    },
    "email": {
      "type": "string",
      "description": "E-mail principal"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone principal"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp principal"
    },
    "site": {
      "type": "string",
      "description": "Site principal"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn da empresa"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram da empresa"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "municipio": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "Estado"
    },
    "status": {
      "type": "string",
      "enum": [
        "salvo",
        "no_crm",
        "contatado"
      ],
      "default": "salvo",
      "description": "Etapa da prospec\u00e7\u00e3o"
    },
    "crm_lead_id": {
      "type": "string",
      "description": "Lead criado no CRM"
    },
    "icp_id": {
      "type": "string",
      "description": "ICP de origem deste prospect"
    },
    "origem_prospeccao": {
      "type": "string",
      "description": "Origem da prospec\u00e7\u00e3o (ex: Manual, Prospec\u00e7\u00e3o Autom\u00e1tica)"
    },
    "dados_kipflow": {
      "type": "object",
      "description": "Dados completos retornados pelo Kipflow"
    },
    "score": {
      "type": "number",
      "description": "Lead score de 0 a 100 calculado pela IA"
    },
    "score_faixa": {
      "type": "string",
      "enum": [
        "Frio",
        "Morno",
        "Quente"
      ],
      "description": "Faixa de temperatura do prospect"
    },
    "analise_resumo": {
      "type": "string",
      "description": "Resumo da an\u00e1lise feita pela IA"
    },
    "pontos_fortes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sinais positivos identificados pela IA"
    },
    "riscos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Riscos ou pontos de aten\u00e7\u00e3o"
    },
    "produtos_sugeridos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Produtos Gl\u00f3ria recomendados pela IA"
    },
    "abordagem_sugerida": {
      "type": "string",
      "description": "Abordagem comercial sugerida pela IA"
    },
    "analisado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da \u00faltima an\u00e1lise da IA"
    },
    "respondeu_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o prospect respondeu e a cad\u00eancia foi interrompida"
    },
    "opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Contato pediu para n\u00e3o receber mais mensagens (lista de supress\u00e3o)"
    },
    "opt_out_motivo": {
      "type": "string",
      "description": "Motivo/origem do opt-out"
    },
    "intent_score": {
      "type": "number",
      "default": 0,
      "description": "Inten\u00e7\u00e3o de compra de 0 a 100, aumenta conforme intera\u00e7\u00f5es"
    },
    "qualificacao": {
      "type": "object",
      "description": "Informa\u00e7\u00f5es de qualifica\u00e7\u00e3o coletadas pelo Agente Comercial",
      "properties": {
        "empresa": {
          "type": "string"
        },
        "segmento": {
          "type": "string"
        },
        "cargo_pessoa": {
          "type": "string"
        },
        "quantidade_funcionarios": {
          "type": "string"
        },
        "unidades": {
          "type": "string"
        },
        "sistema_atual": {
          "type": "string"
        },
        "principal_problema": {
          "type": "string"
        },
        "produto_interesse": {
          "type": "string"
        },
        "urgencia": {
          "type": "string"
        },
        "decisao_depende_de_outra_pessoa": {
          "type": "string"
        },
        "orcamento_informado": {
          "type": "string"
        },
        "observacoes": {
          "type": "string"
        }
      }
    },
    "objecoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Obje\u00e7\u00f5es comerciais identificadas na conversa"
    },
    "interesse_registrado": {
      "type": "string",
      "description": "Interesse comercial declarado pelo contato"
    },
    "qualificado_em": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o da qualifica\u00e7\u00e3o pelo Agente Comercial"
    },
    "consentimento_whatsapp": {
      "type": "object",
      "description": "Consentimento do contato para conversas por WhatsApp",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "nao_informado",
            "concedido",
            "negado"
          ]
        },
        "origem": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "format": "date-time"
        },
        "observacao": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "cnpj",
    "razao_social"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}