{
  "name": "Lead",
  "type": "object",
  "properties": {
    "nome_cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "nome_empresa": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "email_cliente": {
      "type": "string",
      "format": "email",
      "description": "Email do cliente"
    },
    "telefone_cliente": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "produto_interesse": {
      "type": "string",
      "enum": [
        "Atendimento_IA_24_7",
        "Maquina_de_Videos",
        "Gloria_Clinica",
        "Gloria_Vendas",
        "Especialistas_Virtuais",
        "Sites_em_24_Horas"
      ],
      "description": "Produto de interesse"
    },
    "estagio": {
      "type": "string",
      "enum": [
        "Prospeccao",
        "Contatado",
        "Engajado",
        "Qualificado",
        "Reuniao_Marcada",
        "Reuniao_Realizada",
        "Em_Avaliacao",
        "Proposta",
        "Negociacao",
        "Negocio_Fechado",
        "Implantacao",
        "Inicio_de_Uso",
        "Estavel",
        "Desistiu"
      ],
      "default": "Reuniao_Marcada",
      "description": "Est\u00e1gio no funil de vendas"
    },
    "estagio_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima mudan\u00e7a de est\u00e1gio"
    },
    "temperatura": {
      "type": "string",
      "enum": [
        "Frio",
        "Morno",
        "Quente"
      ],
      "description": "Temperatura comercial do lead calculada pela IA"
    },
    "temperatura_score": {
      "type": "number",
      "description": "Score de 0 a 100 que define a temperatura"
    },
    "proxima_melhor_acao": {
      "type": "string",
      "description": "Pr\u00f3xima melhor a\u00e7\u00e3o recomendada pela IA"
    },
    "proxima_acao_motivo": {
      "type": "string",
      "description": "Por que esta a\u00e7\u00e3o foi recomendada"
    },
    "proxima_acao_canal": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Email",
        "Ligacao",
        "Reuniao",
        "Interno"
      ],
      "description": "Canal sugerido para executar a a\u00e7\u00e3o"
    },
    "proxima_acao_prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo sugerido para executar a a\u00e7\u00e3o"
    },
    "proxima_acao_atualizada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a IA calculou a pr\u00f3xima melhor a\u00e7\u00e3o"
    },
    "valor_estimado": {
      "type": "number",
      "description": "Valor estimado do neg\u00f3cio em reais"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o lead"
    },
    "proximos_passos": {
      "type": "string",
      "description": "Pr\u00f3ximos passos a serem executados"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para entrega/conclus\u00e3o"
    },
    "tarefas_pendentes": {
      "type": "string",
      "description": "Lista de tarefas pendentes"
    },
    "status_onboarding": {
      "type": "string",
      "enum": [
        "Nao_Iniciado",
        "Em_Andamento",
        "Aguardando_Cliente",
        "Concluido"
      ],
      "description": "Status do processo de onboarding"
    },
    "agendamento_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "negocio_id": {
      "type": "string",
      "description": "ID do neg\u00f3cio fechado relacionado"
    },
    "data_reuniao": {
      "type": "string",
      "format": "date",
      "description": "Data da reuni\u00e3o"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "Media",
        "Alta"
      ],
      "default": "Media",
      "description": "Prioridade do lead"
    }
  },
  "required": [
    "nome_cliente"
  ],
  "anyOf": [
    {
      "required": [
        "email_cliente"
      ]
    },
    {
      "required": [
        "telefone_cliente"
      ]
    }
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}