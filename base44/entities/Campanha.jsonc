{
  "name": "Campanha",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da campanha de prospec\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Objetivo da campanha"
    },
    "icp_id": {
      "type": "string",
      "description": "ICP alvo da campanha (vazio = todos)"
    },
    "ativa": {
      "type": "boolean",
      "default": false,
      "description": "Se a cad\u00eancia autom\u00e1tica est\u00e1 ativa"
    },
    "score_minimo": {
      "type": "number",
      "default": 60,
      "description": "Lead score m\u00ednimo para entrar na campanha"
    },
    "limite_diario_envios": {
      "type": "number",
      "default": 30,
      "description": "M\u00e1ximo de mensagens enviadas por dia (America/Recife)"
    },
    "limite_diario_entradas": {
      "type": "number",
      "default": 20,
      "description": "M\u00e1ximo de prospects que entram na cad\u00eancia por dia (America/Recife)"
    },
    "passos": {
      "type": "array",
      "description": "Passos da cad\u00eancia em ordem",
      "items": {
        "type": "object",
        "properties": {
          "canal": {
            "type": "string",
            "enum": [
              "WhatsApp",
              "Email"
            ]
          },
          "dia_offset": {
            "type": "number",
            "description": "Dias ap\u00f3s a entrada do prospect na cad\u00eancia"
          },
          "assunto": {
            "type": "string",
            "description": "Assunto (somente e-mail)"
          },
          "mensagem": {
            "type": "string",
            "description": "Mensagem com vari\u00e1veis {{empresa}}, {{cidade}}, {{produto}}"
          },
          "objetivo": {
            "type": "string",
            "description": "Objetivo da mensagem, usado para orientar a IA"
          },
          "usar_ia": {
            "type": "boolean",
            "default": false,
            "description": "Personalizar a mensagem com IA no momento do envio"
          }
        }
      }
    },
    "ultima_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima execu\u00e7\u00e3o da cad\u00eancia"
    },
    "video_url": {
      "type": "string",
      "description": "URL da demonstra\u00e7\u00e3o espec\u00edfica desta campanha/segmento"
    },
    "agenda_url": {
      "type": "string",
      "description": "URL p\u00fablica para agendar reuni\u00e3o comercial"
    },
    "nome_remetente": {
      "type": "string",
      "default": "Thiago",
      "description": "Nome usado nas mensagens comerciais"
    },
    "site_gloria": {
      "type": "string",
      "default": "gloriavirtual.com",
      "description": "Site exibido nas mensagens comerciais"
    },
    "hora_inicio_envios": {
      "type": "number",
      "default": 8,
      "description": "Hora local de Recife a partir da qual a campanha pode enviar mensagens"
    },
    "hora_fim_envios": {
      "type": "number",
      "default": 18,
      "description": "Hora local de Recife a partir da qual a campanha deixa de enviar mensagens"
    },
    "somente_dias_uteis": {
      "type": "boolean",
      "default": true,
      "description": "Quando ativo, n\u00e3o envia mensagens aos s\u00e1bados e domingos"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}