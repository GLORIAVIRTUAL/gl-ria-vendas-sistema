{
  "name": "Produto",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "description": "Nome do produto"
    },
    "preco_recomendado": {
      "type": "number",
      "description": "Pre\u00e7o recomendado de venda"
    },
    "custo_fixo": {
      "type": "number",
      "description": "Custo fixo do produto"
    },
    "impostos": {
      "type": "number",
      "description": "Impostos (9% do pre\u00e7o)"
    },
    "taxa_cartao": {
      "type": "number",
      "description": "Taxa de cart\u00e3o (4.4% do pre\u00e7o)"
    },
    "comissao_vendedor": {
      "type": "number",
      "description": "Comiss\u00e3o do vendedor (20% do pre\u00e7o)"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total (fixo + impostos + taxa + comiss\u00e3o)"
    },
    "lucro_liquido": {
      "type": "number",
      "description": "Lucro l\u00edquido (pre\u00e7o - custo total)"
    },
    "margem_liquida": {
      "type": "number",
      "description": "Margem l\u00edquida em porcentagem"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto est\u00e1 ativo"
    }
  },
  "required": [
    "produto",
    "preco_recomendado"
  ]
}