{
  "name": "DisparoEmail",
  "type": "object",
  "properties": {
    "agendamento_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "email_destinatario": {
      "type": "string",
      "format": "email",
      "description": "Email do destinat\u00e1rio"
    },
    "assunto": {
      "type": "string",
      "description": "Assunto do email"
    },
    "corpo": {
      "type": "string",
      "description": "Corpo do email (HTML suportado)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Confirmacao",
        "Lembrete"
      ],
      "description": "Tipo de email"
    },
    "status": {
      "type": "string",
      "enum": [
        "Programado",
        "Processando",
        "Enviado",
        "Erro"
      ],
      "default": "Programado",
      "description": "Status do disparo"
    },
    "data_programada": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora programada para envio"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora real do envio"
    },
    "horas_antes": {
      "type": "integer",
      "description": "Quantas horas antes da reuni\u00e3o o lembrete foi enviado (null se for confirma\u00e7\u00e3o)"
    },
    "erro_mensagem": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "claim_token": {
      "type": "string",
      "description": "Token tempor\u00e1rio de claim para evitar processamento concorrente"
    },
    "processando_em": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o disparo foi reivindicado por um processador"
    },
    "tentativas": {
      "type": "integer",
      "default": 0,
      "description": "Quantidade de tentativas de envio"
    }
  },
  "required": [
    "email_destinatario",
    "assunto",
    "corpo",
    "tipo",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}