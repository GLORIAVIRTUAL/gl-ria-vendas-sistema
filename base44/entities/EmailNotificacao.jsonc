{
  "name": "EmailNotificacao",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Assunto do email"
    },
    "from": {
      "type": "string",
      "description": "Remetente do email"
    },
    "text": {
      "type": "string",
      "description": "Texto do email"
    },
    "lido": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi visualizada"
    }
  },
  "required": [
    "subject",
    "from"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}