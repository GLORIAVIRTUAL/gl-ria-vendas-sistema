{
  "name": "Indicacao",
  "type": "object",
  "properties": {
    "negocio_id": {
      "type": "string",
      "description": "Cliente que indicou"
    },
    "cliente_indicador": {
      "type": "string",
      "description": "Nome do cliente que indicou"
    },
    "empresa_indicadora": {
      "type": "string",
      "description": "Empresa do cliente que indicou"
    },
    "status": {
      "type": "string",
      "enum": [
        "Solicitada",
        "Recebida",
        "Convertida"
      ],
      "default": "Solicitada",
      "description": "Status da indica\u00e7\u00e3o"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem enviada ao cliente"
    },
    "indicado_nome": {
      "type": "string",
      "description": "Nome do contato indicado"
    },
    "indicado_empresa": {
      "type": "string",
      "description": "Empresa do contato indicado"
    },
    "indicado_telefone": {
      "type": "string",
      "description": "Telefone do contato indicado"
    },
    "lead_id": {
      "type": "string",
      "description": "Lead criado no CRM a partir da indica\u00e7\u00e3o"
    }
  },
  "required": [
    "negocio_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}