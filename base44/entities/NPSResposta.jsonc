{
  "name": "NPSResposta",
  "type": "object",
  "properties": {
    "negocio_id": {
      "type": "string",
      "description": "Cliente relacionado"
    },
    "nome_cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "nome_empresa": {
      "type": "string",
      "description": "Empresa do cliente"
    },
    "nota": {
      "type": "number",
      "description": "Nota de 0 a 10"
    },
    "classificacao": {
      "type": "string",
      "enum": [
        "Detrator",
        "Neutro",
        "Promotor"
      ],
      "description": "Classifica\u00e7\u00e3o NPS"
    },
    "comentario": {
      "type": "string",
      "description": "Coment\u00e1rio do cliente"
    }
  },
  "required": [
    "negocio_id",
    "nota"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}