{
  "name": "OnboardingCliente",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead relacionado"
    },
    "agendamento_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "produtos_escolhidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de produtos escolhidos pelo cliente"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail do cliente"
    },
    "nome_empresa": {
      "type": "string",
      "description": "Nome da Empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "ramos_atividade": {
      "type": "string",
      "description": "Ramos de Atividade"
    },
    "produtos_servicos": {
      "type": "string",
      "description": "Produtos ou Servi\u00e7os"
    },
    "horario_funcionamento": {
      "type": "string",
      "description": "Hor\u00e1rio de Funcionamento"
    },
    "portfolio": {
      "type": "string",
      "description": "Portf\u00f3lio"
    },
    "contatos": {
      "type": "string",
      "description": "Contatos"
    },
    "diferenciais": {
      "type": "string",
      "description": "Diferenciais"
    },
    "precos": {
      "type": "string",
      "description": "Pre\u00e7os"
    },
    "profissionais": {
      "type": "string",
      "description": "Profissionais"
    },
    "email_comercial": {
      "type": "string",
      "format": "email",
      "description": "Email comercial"
    },
    "endereco_empresa": {
      "type": "string",
      "description": "Endere\u00e7o da empresa"
    },
    "telefone_whatsapp": {
      "type": "string",
      "description": "Telefone / WhatsApp"
    },
    "telegram": {
      "type": "string",
      "description": "Telegram"
    },
    "outros_contatos": {
      "type": "string",
      "description": "Outros contatos"
    },
    "pais": {
      "type": "string",
      "description": "Pa\u00eds"
    },
    "estado": {
      "type": "string",
      "description": "Estado"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "rua": {
      "type": "string",
      "description": "Rua"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero"
    },
    "site": {
      "type": "string",
      "description": "Site"
    },
    "youtube": {
      "type": "string",
      "description": "YouTube"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram"
    },
    "facebook": {
      "type": "string",
      "description": "Facebook"
    },
    "tiktok": {
      "type": "string",
      "description": "TikTok"
    },
    "x_twitter": {
      "type": "string",
      "description": "X (Twitter)"
    },
    "concorrentes": {
      "type": "string",
      "description": "Concorrentes e Refer\u00eancias"
    },
    "promocoes": {
      "type": "string",
      "description": "Promo\u00e7\u00f5es Atuais"
    },
    "faq": {
      "type": "string",
      "description": "Perguntas Frequentes (FAQ)"
    },
    "logotipo_url": {
      "type": "string",
      "description": "URL do logotipo"
    },
    "outros_arquivos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de outros arquivos"
    }
  },
  "required": [
    "email",
    "nome_empresa",
    "ramos_atividade",
    "produtos_servicos",
    "horario_funcionamento",
    "email_comercial",
    "telefone_whatsapp",
    "pais",
    "estado",
    "cidade",
    "cep",
    "bairro",
    "rua",
    "numero",
    "logotipo_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}