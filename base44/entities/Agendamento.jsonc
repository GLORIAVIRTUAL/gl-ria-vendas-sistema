{
  "name": "Agendamento",
  "type": "object",
  "properties": {
    "nome_cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "email_cliente": {
      "type": "string",
      "format": "email",
      "description": "Email do cliente"
    },
    "telefone_cliente": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "nome_empresa": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "site_instagram_empresa": {
      "type": "string",
      "description": "Site ou Instagram da empresa"
    },
    "processo_resolver": {
      "type": "string",
      "description": "Processo que o cliente deseja resolver"
    },
    "produto": {
      "type": "string",
      "description": "Produto (legado / opcional)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da reuni\u00e3o"
    },
    "horario": {
      "type": "string",
      "enum": [
        "08:00",
        "09:00",
        "10:00",
        "11:00",
        "12:00",
        "13:00",
        "14:00",
        "15:00",
        "16:00",
        "17:00",
        "18:00",
        "19:00",
        "20:00"
      ],
      "description": "Hor\u00e1rio da reuni\u00e3o"
    },
    "link_reuniao": {
      "type": "string",
      "description": "Link da reuni\u00e3o online"
    },
    "status": {
      "type": "string",
      "enum": [
        "Agendada",
        "Confirmada",
        "Conclu\u00edda",
        "Cancelada"
      ],
      "default": "Agendada",
      "description": "Status da reuni\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Manual",
        "Chatbot",
        "Agendamento Online"
      ],
      "default": "Manual",
      "description": "Origem do agendamento"
    },
    "briefing_ia": {
      "type": "string",
      "description": "Briefing comercial gerado automaticamente pela IA antes da reuni\u00e3o"
    },
    "briefing_gerado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o briefing comercial foi gerado"
    },
    "briefing_status": {
      "type": "string",
      "enum": [
        "pendente",
        "gerado",
        "erro"
      ],
      "default": "pendente",
      "description": "Status do briefing autom\u00e1tico"
    },
    "briefing_erro": {
      "type": "string",
      "description": "\u00daltimo erro na gera\u00e7\u00e3o do briefing"
    }
  },
  "required": [
    "nome_cliente",
    "email_cliente",
    "data",
    "horario"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}